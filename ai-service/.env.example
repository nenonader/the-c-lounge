# Made By Eng Nayer Nader
# The C Lounge — clounge-ai (Private Concierge) environment template, v73.
# Copy to .env for local work. NEVER commit a filled-in copy: .env is git-ignored.

ENVIRONMENT=development

# --- Anthropic ---------------------------------------------------------------
# Use a WORKSPACE-SCOPED key. An organisation-scoped key returns HTTP 400 on
# every Messages call ("This API key is not scoped to a workspace...") — that is
# exactly what took the live concierge down on 06-09-2026. If you must use an
# organisation key, set ANTHROPIC_WORKSPACE_ID below and the service will send
# the anthropic-workspace-id header on every request.
ANTHROPIC_API_KEY=sk-ant-your-workspace-scoped-key
ANTHROPIC_WORKSPACE_ID=

ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_UTILITY_MODEL=claude-haiku-4-5-20251001
MODEL_FALLBACK_CHAIN=claude-sonnet-5,claude-opus-4-8,claude-sonnet-4-6,claude-haiku-4-5-20251001
ANTHROPIC_TIMEOUT_SECONDS=40
ANTHROPIC_MAX_RETRIES=2

# --- Generation --------------------------------------------------------------
# TEMPERATURE / TOP_P are deliberately absent: the Sonnet 5 family returns
# HTTP 400 for a non-default sampling parameter. brain.py omits them for that
# family regardless. Do not add them.
MAX_NEW_TOKENS=1400
MAX_OUTPUT_CHARS=1100
MAX_MESSAGE_CHARS=1200
MAX_HISTORY_TURNS=10
GENERATION_ATTEMPTS=2
STREAM_WORD_DELAY_MS=18

# --- Behaviour ---------------------------------------------------------------
HONEST_FALLBACK=true
FALLBACK_IS_LOUD=true
STARTUP_SELF_TEST=true
SELF_HEAL_MINUTES=5

# --- Availability ------------------------------------------------------------
KEEPALIVE_ENABLED=true
KEEPALIVE_MINUTES=4
KEEPALIVE_JITTER_SECONDS=45
# Render injects RENDER_EXTERNAL_URL automatically; set these only to override.
SELF_URL=
PEER_URL=http://127.0.0.1:3001

# --- Safety ------------------------------------------------------------------
SERVICE_API_KEY=shared-with-clounge-web-as-AI_SERVICE_KEY
ADMIN_API_KEY=separate-key-for-admin-diagnose-and-turns
REQUIRE_SERVICE_KEY=true
INJECTION_BLOCK_SCORE=3
INJECTION_MAX_STRIKES=4
RATE_LIMIT_PER_MIN=20
SESSION_RATE_LIMIT_PER_MIN=12
SESSION_TTL_SECONDS=21600
MAX_SESSIONS=5000
MAX_BODY_BYTES=32768
ALLOWED_ORIGINS=http://localhost:3001

# --- Observability -----------------------------------------------------------
# Never enable LOG_PROMPTS in production: it writes visitor messages to the log.
LOG_PROMPTS=false
TELEMETRY_BUFFER=400
