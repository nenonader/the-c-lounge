# Made By Eng Nayer Nader
# The C Lounge — clounge-web (site + private API) environment template, v73.
# Copy to .env for local work. NEVER commit a filled-in copy: .env is git-ignored.

NODE_ENV=development
PORT=3001
SITE_SOURCE=thecloungeworld.com
STATIC_SITE_ROOT=../public
ACCESS_LOG=true
TRUST_PROXY=false
FORCE_HTTPS=false
ALLOWED_ORIGINS=http://localhost:3001

# --- Link to the AI service --------------------------------------------------
AI_SERVICE_URL=http://127.0.0.1:8001
# Byte-identical to SERVICE_API_KEY in clounge-ai. A mismatch is a silent 401
# that looks exactly like an outage.
AI_SERVICE_KEY=shared-with-clounge-ai-as-SERVICE_API_KEY
AI_STREAM_TIMEOUT_MS=20000
AI_STREAM_COLD_TIMEOUT_MS=25000
AI_ROUTING_ENABLED=true
AI_ROUTING_MIN_CONFIDENCE=0.68
AI_ROUTING_TIMEOUT_MS=12000

# --- Availability ------------------------------------------------------------
# Render frees an idle instance after ~15 minutes. Both services ping themselves
# and each other well inside that window; ops/keepalive adds an external cron.
KEEPALIVE_ENABLED=true
AI_KEEPALIVE_MINUTES=4
KEEPALIVE_JITTER_SECONDS=45
# Render injects RENDER_EXTERNAL_URL automatically; set this only to override.
SELF_URL=

# --- Firebase ----------------------------------------------------------------
FIREBASE_PROJECT_ID=your-firebase-project
FIREBASE_SERVICE_ACCOUNT_PATH=/etc/secrets/serviceAccountKey.json

# --- Secrets -----------------------------------------------------------------
LOG_HASH_SALT=64-hex-characters
RESEND_API_KEY=
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_USER=private@example.com
SMTP_PASS=
SMTP_FROM=private@example.com
SMTP_TIMEOUT_MS=10000
SMTP_VERIFY_ON_START=true
MAIL_DEADLINE_MS=15000

# --- Desks -------------------------------------------------------------------
DESK_CONCIERGE=Concierge@TheCLoungeWorld.com
DESK_EXECUTIVE=Executive@TheCLoungeWorld.com
DESK_PRIVATE=Private@TheCLoungeWorld.com
ROUTING_CC_FALLBACK=false
WHATSAPP_NUMBER=201114399976

# --- Rate limits -------------------------------------------------------------
API_RATE_LIMIT=90
CHAT_RATE_LIMIT=20
INQUIRY_RATE_LIMIT=8
ANALYTICS_RATE_LIMIT=240

# --- Retention ---------------------------------------------------------------
CHAT_RETENTION_DAYS=30
ANALYTICS_RETENTION_DAYS=180
PII_RETENTION_DAYS=180
